# Serveur LePalier (dev). ${LEPALIER_WIREGUARD} : sous-réseau WireGuard autorisé sur /ops (valeur définitive au lot 2).
server {
  listen 443 ssl;
  http2 on;
  ssl_certificate /etc/nginx/certs/dev.crt;
  ssl_certificate_key /etc/nginx/certs/dev.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 1m;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;

  include /etc/nginx/reponses_json.conf;

  include /etc/nginx/verification_identite.conf;
  location = /api/identity/auth/verify { try_files /introuvable @introuvable; }
  location /internal/ { try_files /introuvable @introuvable; }
  location ~ ^/api/[^/]+/internal/ { try_files /introuvable @introuvable; }

  # Connexion, code, activation, réinitialisation : publiques, limitées par adresse
  location /api/identity/auth/ {
    limit_req zone=auth burst=10 nodelay;
    error_page 429 = @trop_de_requetes;
    include /etc/nginx/proxy_common.conf;
    include /etc/nginx/entetes_identite_vides.conf;
    set $identity identity:8000;
    rewrite ^/api/identity/(.*)$ /$1 break;
    proxy_pass http://$identity;
  }

  location /api/ {
    include /etc/nginx/api_services.conf;
  }

  # Supervision (Grafana au lot 2) : réseau WireGuard seulement (TEC-SEC-18)
  location /ops/ {
    allow ${LEPALIER_WIREGUARD};
    deny all;
    try_files /introuvable @introuvable;
  }

  location / {
    include /etc/nginx/proxy_common.conf;
    include /etc/nginx/entetes_identite_vides.conf;
    proxy_set_header X-Nonce $request_id;
    set $front front:3000;
    proxy_pass http://$front;
    # front arrêté : son adresse reste en cache 10 s ; échec rapide plutôt qu'une attente de 60 s
    proxy_connect_timeout 2s;
    # front absent ou arrêté : page de maintenance plutôt qu'une erreur brute (TEC-WEB-08)
    error_page 502 504 =503 /maintenance.html;
  }
  location = /maintenance.html {
    internal;
    root /usr/share/nginx/maintenance;
  }
}

# Écoute interne du BFF (front côté serveur) : lectures seulement (GET, HEAD) de /api/*, avec la même vérification
# d'identité et le même vidage des en-têtes ; jamais /api/identity/auth/* ni /internal/* ; port jamais publié.
server {
  listen 8081;
  # au niveau du serveur, avant le choix de la location : un if dans location /api/ ne s'appliquerait pas aux
  # locations imbriquées (routage des services) ; une écriture ne passe jamais par cette écoute
  if ($request_method !~ ^(GET|HEAD)$) { return 405; }
  include /etc/nginx/reponses_json.conf;
  include /etc/nginx/verification_identite.conf;
  location /api/identity/auth/ { try_files /introuvable @introuvable; }
  location /internal/ { try_files /introuvable @introuvable; }
  location ~ ^/api/[^/]+/internal/ { try_files /introuvable @introuvable; }
  location /api/ {
    include /etc/nginx/api_services.conf;
  }
  location / { try_files /introuvable @introuvable; }
}

# Vérification de santé de Compose : port interne au conteneur, jamais publié
server {
  listen 127.0.0.1:8080;
  access_log off;
  location = /_sante { return 204; }
}
